<Project>

  <!--
    Single source of truth for the version of both Lifeline binaries.

    The Condition guarantees this does NOT apply to anything under
    .deps/skua/ (which build.sh clones and builds). Skua.Core.* will
    keep whatever version Skua's own Directory.Build.props assigns, or
    the SDK default if Skua doesn't have one.

    To release a new version, change <Version> below. Both the plugin
    DLL and the helper EXE pick up the same number.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lifeline' or '$(MSBuildProjectName)' == 'LifelineHelper'">
    <Version>1.0.0</Version>

    <!--
      Stops the .NET SDK from automatically appending the git commit hash
      (e.g., "1.0.0+f5403b0e") to the version string. 

      With this set to false, the About tab will cleanly show "1.0.0",
      and the version will ONLY change when you manually bump the <Version> 
      tag above.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
